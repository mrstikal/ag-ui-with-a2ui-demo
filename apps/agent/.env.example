# Explicit execution mode: fixture | live.
# fixture is deterministic, visibly labeled in the UI, and uses no model.
# live requires MODEL_ID and MODEL_API_KEY.
AGENT_MODE=fixture

# Required only for AGENT_MODE=live.
MODEL_ID=
MODEL_BASE_URL=
MODEL_API_KEY=
# Optional output cap; default 2048. Use 4096 for reasoning-heavy or larger forms.
MODEL_MAX_TOKENS=2048
